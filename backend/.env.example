# رابط قاعدة البيانات PostgreSQL (من Render أو Railway أو Neon أو Supabase)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# مفتاح تشفير التوكنات (ولّد مفتاحاً عشوائياً قوياً بطول 64 حرفاً على الأقل)
JWT_SECRET="<GENERATE_64_CHAR_RANDOM_HEX_SECRET>"
PUBLIC_WEB_URL="https://unifood.store"
WHATSAPP_SESSION_ENC_KEY="<GENERATE_64_CHAR_RANDOM_HEX_SECRET>"

# منفذ السيرفر (Render/Railway يقومون بتعيينه تلقائياً)
PORT=5000
