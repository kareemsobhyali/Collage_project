# ==========================================
# UniFood Platform - Environment Variables
# ==========================================

# Server Port
PORT=5000

# PostgreSQL Database Connection URL
# Local Example: postgresql://postgres:postgres@localhost:5432/unifood_db?schema=public
# Render / Neon / Railway Example: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/unifood_db?schema=public"

# JWT Secret Key (Generate a strong 64+ char random secret, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET="<GENERATE_64_CHAR_RANDOM_HEX_SECRET>"
PUBLIC_WEB_URL="https://unifood.store"
WHATSAPP_SESSION_ENC_KEY="<GENERATE_64_CHAR_RANDOM_HEX_SECRET>"
