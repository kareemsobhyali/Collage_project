[Unit]
Description=Customer Order Tracker Service (trackorder.unifood.store)
After=network.target

[Service]
User=root
WorkingDirectory=/opt/customer-order-tracker
Environment="PORT=8005"
ExecStart=/opt/customer-order-tracker/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8005
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
